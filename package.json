{
  "name": "workshopos-pwa-demo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "start": "npm run local:container",
    "test:harness": "node scripts/verify-harness.mjs",
    "test:e2e": "playwright test",
    "test:unit": "tsx --test unit-tests/*.test.ts",
    "test:production": "tsx --test production/tests/**/*.test.ts",
    "test:production:typecheck": "tsc -p production/tsconfig.json",
    "db:up": "docker compose up -d --wait db",
    "db:migrate": "tsx production/local/migrate.ts",
    "api:local": "tsx production/local/server.ts",
    "local:container": "npm run db:migrate && npm run api:local",
    "local:up": "docker compose up --build -d --wait",
    "local:test": "node scripts/test-local.mjs",
    "local:logs": "docker compose logs -f app",
    "local:down": "docker compose down"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1131.0",
    "@vitejs/plugin-react": "^5.0.1",
    "aws-jwt-verify": "^5.2.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.542.0",
    "pg": "^8.16.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sql.js": "^1.14.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/sql.js": "^1.4.11",
    "playwright": "^1.63.0",
    "tsx": "^4.20.5"
  }
}
