{
  "name": "workshopos-pwa-demo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "start": "node scripts/serve.mjs",
    "test:harness": "node scripts/verify-harness.mjs",
    "test:e2e": "playwright test",
    "test:production": "tsx --test production/tests/**/*.test.ts",
    "test:production:typecheck": "tsc -p production/tsconfig.json"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.1",
    "lucide-react": "^0.542.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sql.js": "^1.14.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/node": "^24.3.0",
    "@types/sql.js": "^1.4.11",
    "playwright": "^1.63.0",
    "tsx": "^4.20.5"
  }
}
