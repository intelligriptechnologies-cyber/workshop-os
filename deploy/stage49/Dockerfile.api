FROM python:3.13-slim@sha256:cf50a4f6ac4f026458b08d5222023d700ac806410dff5e9ca8728fa44f2b850f
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/slice:/workspace:/rehearsal:/tools/import-planner:/deployment
WORKDIR /workspace
COPY requirements.lock /workspace/requirements.lock
RUN pip install --no-cache-dir -r requirements.lock
COPY workspace/ /workspace/
COPY slice/ /slice/
COPY schema/ /schema/
COPY rehearsal/ /rehearsal/
COPY planner/ /tools/import-planner/
COPY evidence/ /evidence/
COPY deployment/ /deployment/
RUN useradd --uid 10001 --create-home workshopos
USER 10001
CMD ["python", "-m", "uvicorn", "api:app", "--host", "0.0.0.0", "--port", "8000", "--no-access-log", "--no-proxy-headers"]
