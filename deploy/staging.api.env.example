# Copy outside the repository to /opt/workshop/staging/secrets/workshopos-api.env
# (or point WORKSHOPOS_STAGING_API_ENV_FILE at the secured path). Never place real
# credentials in this template or commit a populated version.

# Must use the same password as POSTGRES_PASSWORD in workshopos-db.env. This
# connection is private to the Compose network and never exposed to a browser
# or host port.
WORKSHOPOS_DATABASE_URL=postgresql+psycopg://workshopos_admin:REPLACE_WITH_A_UNIQUE_LONG_PASSWORD@db:5432/workshopos

# Cognito required for non-demo staging authentication.
WORKSHOPOS_COGNITO_CLIENT_ID=REPLACE_WITH_COGNITO_PUBLIC_CLIENT_ID
WORKSHOPOS_COGNITO_ISSUER=https://cognito-idp.REGION.amazonaws.com/USER_POOL_ID
WORKSHOPOS_COGNITO_JWKS_URL=https://cognito-idp.REGION.amazonaws.com/USER_POOL_ID/.well-known/jwks.json
WORKSHOPOS_COGNITO_AUTHORIZATION_ENDPOINT=https://YOUR_DOMAIN.auth.REGION.amazoncognito.com/oauth2/authorize
WORKSHOPOS_COGNITO_TOKEN_ENDPOINT=https://YOUR_DOMAIN.auth.REGION.amazoncognito.com/oauth2/token
WORKSHOPOS_COGNITO_LOGOUT_ENDPOINT=https://YOUR_DOMAIN.auth.REGION.amazoncognito.com/logout
WORKSHOPOS_COGNITO_CALLBACK_URI=https://workshopos-staging.nexiohyper.com/
WORKSHOPOS_COGNITO_LOGOUT_URI=https://workshopos-staging.nexiohyper.com/

# Comma-separated Cognito subject IDs allowed to bootstrap a Superadmin.
WORKSHOPOS_SUPERADMIN_BOOTSTRAP_SUBJECTS=REPLACE_WITH_INITIAL_ADMIN_SUBJECT
