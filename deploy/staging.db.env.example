# Copy outside the repository to /opt/workshop/staging/secrets/workshopos-db.env
# (or point WORKSHOPOS_STAGING_DB_ENV_FILE at the secured path). Never place real
# credentials in this template or commit a populated version.

# Use the same password in WORKSHOPOS_DATABASE_URL in workshopos-api.env.
POSTGRES_DB=workshopos
POSTGRES_USER=workshopos_admin
POSTGRES_PASSWORD=REPLACE_WITH_A_UNIQUE_LONG_PASSWORD
